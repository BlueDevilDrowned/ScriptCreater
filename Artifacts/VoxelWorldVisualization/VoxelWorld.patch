index 0000000..fe9bfff
--- /dev/null
+++ b/Assets/Scripts/WorldGen/Voxels/VoxelMeshBuilder.cs
@@ -0,0 +1,66 @@
+using System;
+using System.Collections.Generic;
+using UnityEngine;
+using UnityEngine.Rendering;
+
+namespace ProceduralGeneration.WorldGen.Voxels
+{
+    /// <summary>最直接的立方体面构建：一个可见面对应 4 个顶点和 2 个三角形。</summary>
+    public static class VoxelMeshBuilder
+    {
+        // 每组四点按外侧正面绕序排列，使 Cross(b-a,c-a) 指向体素外侧。
+        private static readonly Vector3[] Corners =
+        {
+            new Vector3(1,0,0), new Vector3(1,1,0), new Vector3(1,1,1), new Vector3(1,0,1),
+            new Vector3(0,0,1), new Vector3(0,1,1), new Vector3(0,1,0), new Vector3(0,0,0),
+            new Vector3(0,1,0), new Vector3(0,1,1), new Vector3(1,1,1), new Vector3(1,1,0),
+            new Vector3(0,0,1), new Vector3(0,0,0), new Vector3(1,0,0), new Vector3(1,0,1),
+            new Vector3(1,0,1), new Vector3(1,1,1), new Vector3(0,1,1), new Vector3(0,0,1),
+            new Vector3(0,0,0), new Vector3(0,1,0), new Vector3(1,1,0), new Vector3(1,0,0)
+        };
+        private static readonly Vector3Int[] Directions =
+        {
+            Vector3Int.right, Vector3Int.left, Vector3Int.up,
+            Vector3Int.down, Vector3Int.forward, Vector3Int.back
+        };
+
+        // 此方法在主线程调用。当前版本刻意不引入 Job、异步或贪心网格。
+        public static Mesh Build(VoxelVolume volume, float voxelSize)
+        {
+            if (volume == null) throw new ArgumentNullException(nameof(volume));
+            if (voxelSize <= 0 || float.IsNaN(voxelSize) || float.IsInfinity(voxelSize))
+                throw new ArgumentOutOfRangeException(nameof(voxelSize));
+            var vertices = new List<Vector3>();
+            var normals = new List<Vector3>();
+            var triangles = new List<int>();
+
+            for (int z = 0; z < volume.Depth; z++)
+            for (int y = 0; y < volume.Height; y++)
+            for (int x = 0; x < volume.Width; x++)
+            {
+                if (!volume.IsSolid(x, y, z)) continue;
+                var position = new Vector3(x, y, z);
+                for (int face = 0; face < 6; face++)
+                {
+                    var direction = Directions[face];
+                    if (volume.IsSolid(x + direction.x, y + direction.y, z + direction.z)) continue;
+                    int start = vertices.Count;
+                    for (int corner = 0; corner < 4; corner++)
+                    {
+                        vertices.Add((position + Corners[face * 4 + corner]) * voxelSize);
+                        normals.Add((Vector3)direction);
+                    }
+                    triangles.Add(start); triangles.Add(start + 1); triangles.Add(start + 2);
+                    triangles.Add(start); triangles.Add(start + 2); triangles.Add(start + 3);
+                }
+            }
+
+            var mesh = new Mesh { name = "Density Voxel World", indexFormat = IndexFormat.UInt32 };
+            mesh.SetVertices(vertices);
+            mesh.SetNormals(normals);
+            mesh.SetTriangles(triangles, 0);
+            mesh.RecalculateBounds();
+            return mesh;
+        }
+    }
+}
diff --git a/Assets/Scripts/WorldGen/Voxels/VoxelWorldPreview.cs b/Assets/Scripts/WorldGen/Voxels/VoxelWorldPreview.cs
new file mode 100644
index 0000000..7b744f3
--- /dev/null
+++ b/Assets/Scripts/WorldGen/Voxels/VoxelWorldPreview.cs
@@ -0,0 +1,115 @@
+using System;
+using System.Diagnostics;
+using ProceduralGeneration.WorldGen.Density;
+using UnityEngine;
+
+namespace ProceduralGeneration.WorldGen.Voxels
+{
+    [DisallowMultipleComponent]
+    [RequireComponent(typeof(MeshFilter), typeof(MeshRenderer))]
+    [RequireComponent(typeof(VoxelWorldControls))]
+    public sealed class VoxelWorldPreview : MonoBehaviour
+    {
+        [SerializeField] private Vector3Int worldSize = new Vector3Int(128, 128, 128);
+        [SerializeField, Min(0.001f)] private float voxelSize = 0.5f;
+        [SerializeField] private int seed = 12345;
+        [SerializeField] private Vector3Int sampleOrigin = Vector3Int.zero;
+        [SerializeField] private Color solidColor = new Color(0.5f, 0.55f, 0.6f, 1f);
+        [SerializeField] private Material material;
+        [SerializeField] private bool generateOnStart = true;
+        private Mesh generatedMesh;
+        private Material generatedMaterial;
+
+        public VoxelVolume Volume { get; private set; }
+        public Vector3Int WorldSize => worldSize;
+        public float VoxelSize => voxelSize;
+        public int Seed => seed;
+        public Vector3Int SampleOrigin => sampleOrigin;
+
+        /// <summary>运行时设置生成参数。偏移以整数体素坐标为单位。</summary>
+        public void Generate(Vector3Int size, int worldSeed, Vector3Int origin, float cellSize)
+        {
+            if (size.x <= 0 || size.y <= 0 || size.z <= 0 || cellSize <= 0
+                || float.IsNaN(cellSize) || float.IsInfinity(cellSize))
+                throw new ArgumentOutOfRangeException(nameof(size), "Size and voxel size must be positive and finite.");
+            checked
+            {
+                int count = size.x * size.y * size.z;
+                int endX = origin.x + size.x - 1;
+                int endY = origin.y + size.y - 1;
+                int endZ = origin.z + size.z - 1;
+            }
+            worldSize = size;
+            seed = worldSeed;
+            sampleOrigin = origin;
+            voxelSize = cellSize;
+            Generate();
+        }
+
+        private void Start()
+        {
+            if (generateOnStart) Generate();
+        }
+
+        [ContextMenu("Generate Voxel World")]
+        public void Generate()
+        {
+            if (worldSize.x <= 0 || worldSize.y <= 0 || worldSize.z <= 0 || voxelSize <= 0
+                || float.IsNaN(voxelSize) || float.IsInfinity(voxelSize))
+                throw new ArgumentOutOfRangeException(nameof(worldSize), "Size and voxel size must be positive and finite.");
+            var timer = Stopwatch.StartNew();
+            var fields = WorldFields.CreateLearningDefaults(seed);
+            var volume = new VoxelVolume(worldSize.x, worldSize.y, worldSize.z);
+            volume.Fill(fields.FinalDensity, sampleOrigin.x, sampleOrigin.y, sampleOrigin.z);
+            long samplingMilliseconds = timer.ElapsedMilliseconds;
+            Mesh mesh = VoxelMeshBuilder.Build(volume, voxelSize);
+            ReleaseGeneratedObject(generatedMesh);
+            generatedMesh = mesh;
+            Volume = volume;
+            GetComponent<MeshFilter>().sharedMesh = mesh;
+            ApplyMaterial();
+            UnityEngine.Debug.Log($"Voxel world: {worldSize}, voxel={voxelSize}, solid={volume.SolidCount}, "
+                + $"faces={mesh.vertexCount / 4}, sample={samplingMilliseconds}ms, total={timer.ElapsedMilliseconds}ms", this);
+        }
+
+        private void ApplyMaterial()
+        {
+            if (material != null)
+            {
+                GetComponent<MeshRenderer>().sharedMaterial = material;
+                return;
+            }
+            if (generatedMaterial == null)
+            {
+                Shader shader = Shader.Find("Universal Render Pipeline/Lit") ?? Shader.Find("Standard");
+                if (shader == null) throw new InvalidOperationException("Assign a material supported by the active rendering pipeline.");
+                generatedMaterial = new Material(shader) { name = "Voxel Preview Material" };
+            }
+            generatedMaterial.color = solidColor;
+            GetComponent<MeshRenderer>().sharedMaterial = generatedMaterial;
+        }
+
+        [ContextMenu("Clear Voxel World")]
+        public void Clear()
+        {
+            if (GetComponent<MeshFilter>().sharedMesh == generatedMesh)
+                GetComponent<MeshFilter>().sharedMesh = null;
+            ReleaseGeneratedObject(generatedMesh);
+            generatedMesh = null;
+            Volume = null;
+        }
+
+        private void OnDestroy()
+        {
+            Clear();
+            ReleaseGeneratedObject(generatedMaterial);
+        }
+
+        private static void ReleaseGeneratedObject(UnityEngine.Object value)
+        {
+            if (value == null) return;
+            if (Application.isPlaying) Destroy(value);
+            else DestroyImmediate(value);
+        }
+    }
+}
diff --git a/Assets/Scripts/WorldGen/Voxels/VoxelWorldControls.cs b/Assets/Scripts/WorldGen/Voxels/VoxelWorldControls.cs
new file mode 100644
index 0000000..3cee77e
--- /dev/null
+++ b/Assets/Scripts/WorldGen/Voxels/VoxelWorldControls.cs
@@ -0,0 +1,91 @@
+using System;
+using System.Globalization;
+using UnityEngine;
+
+namespace ProceduralGeneration.WorldGen.Voxels
+{
+    /// <summary>运行时参数面板。仅点击生成按钮时重建，不在每次输入时重建。</summary>
+    [DisallowMultipleComponent]
+    public sealed class VoxelWorldControls : MonoBehaviour
+    {
+        [SerializeField] private bool showPanel = true;
+        private VoxelWorldPreview preview;
+        private string sizeX, sizeY, sizeZ, originX, originY, originZ, seed, voxelSize;
+        private string message = "";
+        private bool initialized;
+
+        private void OnGUI()
+        {
+            if (!Application.isPlaying) return;
+            if (!initialized)
+            {
+                preview = GetComponent<VoxelWorldPreview>();
+                if (preview == null) return;
+                sizeX = preview.WorldSize.x.ToString();
+                sizeY = preview.WorldSize.y.ToString();
+                sizeZ = preview.WorldSize.z.ToString();
+                originX = preview.SampleOrigin.x.ToString();
+                originY = preview.SampleOrigin.y.ToString();
+                originZ = preview.SampleOrigin.z.ToString();
+                seed = preview.Seed.ToString();
+                voxelSize = preview.VoxelSize.ToString(CultureInfo.InvariantCulture);
+                initialized = true;
+            }
+
+            if (GUI.Button(new Rect(12, 12, 280, 28), showPanel ? "Hide world settings" : "Show world settings"))
+                showPanel = !showPanel;
+            if (!showPanel) return;
+            GUILayout.BeginArea(new Rect(12, 46, 320, 350), "Voxel World", GUI.skin.window);
+            GUILayout.Label("Size (voxels): X / Y / Z");
+            DrawVector(ref sizeX, ref sizeY, ref sizeZ);
+            GUILayout.Label("Seed");
+            seed = GUILayout.TextField(seed);
+            GUILayout.Label("Sample origin (voxels): X / Y / Z");
+            DrawVector(ref originX, ref originY, ref originZ);
+            GUILayout.Label("Voxel size (Unity units)");
+            voxelSize = GUILayout.TextField(voxelSize);
+            if (GUILayout.Button("Generate / Regenerate")) Regenerate();
+            if (GUILayout.Button("Clear"))
+            {
+                preview.Clear();
+                message = "World cleared.";
+            }
+            GUILayout.Label(message);
+            GUILayout.EndArea();
+        }
+
+        private static void DrawVector(ref string x, ref string y, ref string z)
+        {
+            GUILayout.BeginHorizontal();
+            x = GUILayout.TextField(x);
+            y = GUILayout.TextField(y);
+            z = GUILayout.TextField(z);
+            GUILayout.EndHorizontal();
+        }
+
+        private void Regenerate()
+        {
+            if (!int.TryParse(sizeX, out int x) || !int.TryParse(sizeY, out int y) || !int.TryParse(sizeZ, out int z)
+                || !int.TryParse(seed, out int worldSeed)
+                || !int.TryParse(originX, out int ox) || !int.TryParse(originY, out int oy) || !int.TryParse(originZ, out int oz)
+                || !float.TryParse(voxelSize, NumberStyles.Float, CultureInfo.InvariantCulture, out float cellSize))
+            {
+                message = "Enter integers for size, seed and origin; use . for decimals.";
+                return;
+            }
+            try
+            {
+                preview.Generate(new Vector3Int(x, y, z), worldSeed, new Vector3Int(ox, oy, oz), cellSize);
+                message = $"Generated {x} x {y} x {z}. Solid: {preview.Volume.SolidCount}";
+            }
+            catch (ArgumentException)
+            {
+                message = "World size and voxel size must be positive and finite.";
+            }
+            catch (OverflowException)
+            {
+                message = "Size or sample coordinates exceed the supported integer range.";
+            }
+        }
+    }
+}
diff --git a/Assets/Scripts/WorldGen/Voxels/README.md b/Assets/Scripts/WorldGen/Voxels/README.md
